# 衰老测序文献追踪站：本地配置模板
#
# 使用方法：复制为 config.env，再填写自己的值。
# config.env 已被 .gitignore 忽略，禁止提交真实密钥。

# ── LLM：必填（支持 OpenAI 兼容的 Chat Completions 接口）──
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=gpt-4o-mini

# 请求控制
LLM_TIMEOUT=90
LLM_DELAY=1.5
LLM_RETRIES=3

# 同一论文跨运行最多自动尝试次数；达到后标记 failed_terminal，避免无限计费。
LLM_MAX_TOTAL_ATTEMPTS=7

# ── NCBI / PubMed ──
# 必填：请使用你自己的真实联系邮箱，供 NCBI 在请求异常时联系。
NCBI_EMAIL=you@example.com

# 推荐但非必填：https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# NCBI 请求间隔（秒）：无 API Key 建议至少 0.34；有 Key 可使用 0.11。
NCBI_REQUEST_DELAY=0.34

# 默认按 PubMed 创建日期追踪，以发现新收录但发表日期较早的记录。
PUBMED_DATE_FIELD=crdt

# 单次查询读取上限与分页大小。
PUBMED_MAX_RESULTS=2000
PUBMED_PAGE_SIZE=200

# 可选：完整覆盖内置的“衰老 AND 测序”PubMed 查询。
# 除非你熟悉 PubMed 检索语法，否则请保持为空。
PUBMED_BASE_QUERY=

# 每日重复检索最近若干个 PubMed 创建日，用于覆盖延迟收录（1-30）。
DAILY_LOOKBACK_DAYS=7

# PubMed 暂无摘要的记录每隔多少天重新检查一次。
NO_ABSTRACT_RETRY_DAYS=30

# ── 其他 OpenAI 兼容服务示例（仅修改上面的三项，不要取消注释后重复定义）──
# DeepSeek:
# LLM_API_URL=https://api.deepseek.com/chat/completions
# LLM_API_KEY=replace-with-your-deepseek-key
# LLM_MODEL=deepseek-flash
#
# 本地 Ollama（只适合本地运行；GitHub Actions 无法访问你电脑上的 localhost）：
# LLM_API_URL=http://localhost:11434/v1/chat/completions
# LLM_API_KEY=not-needed
# LLM_MODEL=qwen2.5:7b
